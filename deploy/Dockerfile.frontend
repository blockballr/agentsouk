# Frontend: build the Vite marketplace, serve with nginx (proxies /api to backend)
FROM node:20-slim AS build
WORKDIR /app
COPY package.json ./
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
RUN npm install
COPY . .
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
ARG SITE_URL=
RUN npm run build -w @agora/web
# Point OG tags at the deployed site if provided
RUN if [ -n "$SITE_URL" ]; then \
      sed -i "s#https://agora-bench.vercel.app#$SITE_URL#g" apps/web/dist/index.html; \
    fi

FROM nginx:alpine
ENV BACKEND_HOST=backend
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["/bin/sh", "-c", "envsubst '$${BACKEND_HOST}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
