# Reference environment for a long-running server deployment.
# Names mirror render.yaml exactly, so the two cannot disagree.
# Copy to .env.local (the Next app loads it) or feed it to the host as real env
# vars. Never commit real secret values; the blanks below are placeholders.

# Process
# Render sets PORT itself; local runs default to 3000 in next start / server.js
PORT=3000
# the standalone server binds this; 0.0.0.0 is required behind a proxy
HOSTNAME=0.0.0.0
NODE_VERSION=22

# Network and settlement
# 97 is BSC testnet (current product), 56 is BSC mainnet. Unset falls back to 56.
TARGET_CHAIN=97
# sandbox (no funds move) | prod (relay signs and pays gas) | b402 (Binance)
FACILITATOR_MODE=sandbox
# required when FACILITATOR_MODE=prod, and by the cron verifier
RELAY_PRIVATE_KEY=
# required when FACILITATOR_MODE=b402
B402_CLIENT_ID=
B402_ACCESS_TOKEN=

# Registry access and build guard
# 8004scan Pro tier key; raises the rate limit from 10 to 500 requests a minute
EIGHT004_API_KEY=
# guards POST /api/index/build and the scout routes; defaults to "dev"
INDEX_SECRET=change-me

# Durable store
# Postgres for receipts, tasks, jobs, claims, boosts, rate limits, verifications.
# BOTH are required: RECEIPTS_STORE=postgres gates the receipt/task/job stores.
DATABASE_URL=postgres://agora:agora@localhost:5432/agora
RECEIPTS_STORE=postgres

# Public origins
# CORS allowlist for src/proxy.ts, comma separated. Only needed while the SPA is
# on a different origin.
WEB_ORIGIN=https://agentsouk.xyz
# Absolute API origin used in the permanent registration URI and by the cron
# routes. Set both on any host that does not provide VERCEL_URL. Change to the
# custom domain once DNS points at the server.
PUBLIC_API_URL=https://api.agentsouk.xyz
BASE_URL=https://api.agentsouk.xyz

# Cron and verifier
# Bearer secret for GET /api/cron/verify and /api/cron/refresh
CRON_SECRET=
VERIFY_LIMIT=40

# Optional RPC overrides
# Blank uses the defaults in packages/core/src/rpc.ts
BSC_MAINNET_RPC_URL=
BSC_TESTNET_RPC_URL=
REGISTRY_RPC_URL=

# Optional features
# ERC-1271 smart-account verification, experimental, off by default
SMART_WALLET_VERIFY=off
BOOST_SECRET=
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
LLM_EVAL_API_KEY=
LLM_EVAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_EVAL_MODEL=gemini-2.5-flash
LLM_EVAL_FALLBACK_MODEL=gemini-2.0-flash

# Web build (Vite, inlined at build time)
VITE_API_URL=https://api.agentsouk.xyz/api
VITE_WC_PROJECT_ID=
VITE_BSC_MAINNET_RPC_URL=
VITE_BSC_TESTNET_RPC_URL=

# Proof scripts only, not read by the deployed server
# scripts/prod-settle-test.mjs
PROD_BUYER_KEY=
PROD_TOKEN_ID=45381
# scripts/deploy-testusd.mjs, one-time testnet deploy
DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC=
