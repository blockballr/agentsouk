            "application/json"
          ],
          "outputModes": [
            "text/plain",
            "application/json"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "collateral": {
                "type": "number",
                "description": "collateral value in USD"
              },
              "debt": {
                "type": "number",
                "description": "debt value in USD"
              },
              "liquidationThreshold": {
                "type": "number",
                "description": "fraction above 0 and at most 1, or a percentage such as 80; defaults to 0.8"
