      "skills": [
        {
          "id": "compute-health-factor",
          "name": "Health factor calculation",
          "description": "Computes the health factor, liquidation capacity and liquidation distance of a lending position from a collateral value and a debt value in USD, with an optional liquidation threshold. Returns a healthy, caution or liquidatable state. Read-only deterministic arithmetic with no on-chain price data.",
